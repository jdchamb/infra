{
  description = "JChambers MacOS System Flake";

  inputs = {
    # This is our primary source for all software packages.
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";

    # This is the tool that manages macOS system settings.
    nix-darwin = {
      url = "github:nix-darwin/nix-darwin/master";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    # We'll add Home Manager here next!
 home-manager = {

url = "github:nix-community/home-manager/master"

inputs.nixpkgs.follows = "nixpkgs";
  };

  # Outputs will go here...
outputs = { self, nix-darwin, nixpkgs, home-manager }:
  let
    # This 'configuration' variable will hold our system rules
    configuration = { pkgs, ... }: {
      # ... we will fill this in next! ...
    };
  in
  {
    # This is where we name your specific Mac (the Hostname)
    darwinConfigurations."308-225660" = nix-darwin.lib.darwinSystem {
      modules = [ 
        configuration 
        home-manager.darwinModules.home-manager
      ];
    };
  };
}
}
